# microWakeWord trainer, CPU - the Apple Silicon target (ARCHITECTURE.md step 2).
#
# .cpu IS A CLAIM ABOUT THE HARDWARE IT USES, NOT THE HARDWARE IT RUNS ON. Multi-arch
# via python:3.12-slim: linux/arm64 on a Mac, linux/amd64 elsewhere, native either
# way. What it does not do is use a GPU.
#
# THE BASE IMAGE HAD TO CHANGE, AND THAT IS THE WHOLE DIFFICULTY OF THIS FILE.
# Dockerfile.mww.cuda builds on tensorflow/tensorflow:2.21.0-gpu. The obvious CPU
# analogue, tensorflow/tensorflow:2.21.0, IS AMD64-ONLY - verified with
# `docker manifest inspect`, which reports a single linux/amd64 manifest and no
# arm64 variant. Using it on a Mac means qemu emulation of a training run, which is
# worse than useless. So TensorFlow comes from PyPI onto a plain Python base
# instead; 2.21.0 publishes manylinux_2_27_aarch64 wheels for cp310-cp313.
#
# WHY THERE IS NO tensorflow-metal HERE. Its newest release (1.2.0, 2025-01-31)
# predates TensorFlow 2.21.0 (2026-03-06) by five minor versions, and it declares no
# TensorFlow dependency at all to check against - `requires_dist` lists only wheel
# and six, because it is a PluggableDevice plugin. Even if it paired, Docker Desktop
# passes no Metal device through. Both roads end in CPU.
#
# WHY THAT IS TOLERABLE HERE MORE THAN ANYWHERE ELSE IN THE PIPELINE. The measured
# CPU baseline is ~46 s per 500 steps on a 25,537-parameter model - about 15 minutes
# for a 10,000-step run - and Dockerfile.mww.cuda already records that a model this
# small may not fill a GPU. The CUDA run of the full four-stage script took 28m02s,
# most of it corpus and features rather than training.
#
# PYTHON 3.12 IS THE INTERSECTION, not a default. tensorflow ships aarch64 wheels
# for cp310-cp313, ai-edge-litert for cp310-cp314, and pymicro-features as a single
# cp39-abi3 aarch64 wheel that covers all of them. 3.12 is inside every one.

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl build-essential libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# From PyPI, because the base image no longer carries it - see the header. Pinned to
# the same version the CUDA image's base provides, so the two trainers are running
# the same TensorFlow and a difference between them cannot be blamed on that.
RUN pip install --no-cache-dir tensorflow==2.21.0

# microWakeWord is not on PyPI - installed from the repo. Pinned to a commit rather
# than main so a rebuild does not silently change the trainer underneath a run.
# Keep MWW_REF in step with Dockerfile.mww.cuda: two trainers on different commits
# would make a CPU/CUDA comparison meaningless.
ARG MWW_REF=main
RUN git clone https://github.com/OHF-Voice/micro-wake-word /opt/micro-wake-word \
    && cd /opt/micro-wake-word \
    && git checkout "$MWW_REF" \
    && git rev-parse HEAD > /opt/mww-commit.txt \
    && pip install --no-cache-dir -e .

# PIN datasets BELOW 4.0, WITH ITS AUDIO EXTRAS - datasets 4.x moved audio decoding
# to torchcodec, and microWakeWord loads clips through `datasets.Audio()`.
#
# tensorboard is needed even though nothing here looks at TensorBoard: mWW's training
# loop calls `tf.summary.scalar` every eval_step_interval steps and TensorFlow raises
# TBNotInstalledError rather than skipping the write, so training dies after exactly
# one eval interval - 500 steps - in a way that reads like a training failure.
RUN pip install --no-cache-dir "datasets[audio]<4.0" tensorboard

# Fail the build rather than a run if the stack does not import. Same checks as the
# CUDA image, minus the CUDA library assertions, plus one this image needs more:
# pymicro-features is a compiled extension, and Dockerfile.mww.cuda notes upstream's
# own notebook installs a macOS fork of it. On linux/arm64 that concern is settled -
# it publishes a cp39-abi3 manylinux aarch64 wheel - but assert it rather than
# trusting this comment.
RUN python3 -c "\
import numpy, tensorflow as tf; \
print('tensorflow', tf.__version__, 'numpy', numpy.__version__); \
assert numpy.__version__.split('.')[0] == '2', 'mWW needs numpy 2.x'" \
    && python3 -c "import pymicro_features; print('pymicro-features OK')" \
    && python3 -c "from mmap_ninja.ragged import RaggedMmap; print('mmap_ninja OK')" \
    && python3 -c "\
from microwakeword.audio.clips import Clips; \
from microwakeword.audio.spectrograms import SpectrogramGeneration; \
from microwakeword.audio.augmentation import Augmentation; \
print('microwakeword OK, pinned at', open('/opt/mww-commit.txt').read().strip())" \
    && python3 -c "\
import datasets, soundfile; \
major = int(datasets.__version__.split('.')[0]); \
print('datasets', datasets.__version__, 'soundfile', soundfile.__version__); \
assert major < 4, 'datasets 4.x needs torchcodec to decode audio - see the pin above'" \
    && python3 -c "\
import tensorflow as tf; \
tf.summary.scalar; \
import tensorboard; print('tensorboard', tensorboard.__version__)" \
    && python3 -c "\
from ai_edge_litert.interpreter import Interpreter; \
print('ai-edge-litert OK')" \
    && python3 -c "\
import tensorflow as tf; \
print('visible GPUs:', tf.config.list_physical_devices('GPU') or 'none - expected, this is the CPU image')"

# COPIED so the import check runs at BUILD time; docker-compose mounts train/ and
# tts-service/ over the copies at runtime. Same split, same reasons, as every other
# trainer image here. The TTS protocol client lives in tts-service/ at the repo root;
# train/corpus/__init__.py adds it to sys.path, so the import below exercises it.
# The engines are not in this image - the trainers are protocol clients and the
# engines are the kokoro/piper compose services.
COPY train/ ./train/
COPY tts-service/ ./tts-service/

RUN python3 -c "import train.corpus.augment, train.corpus.negatives, \
                       train.corpus.real, train.corpus.piper, \
                       train.corpus.kokoro"
